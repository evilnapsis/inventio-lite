{% extends "layouts/main.html.twig" %}
{% block title %}Compras{% endblock %}
{% block content %}
<div class="row">
	<div class="col-md-12">
		<h1><i class="bi bi-bag"></i> Compras</h1>
		<div class="clearfix"></div>
		<div class="card">
			<div class="card-header">
				COMPRAS
			</div>
			<div class="card-body p-0">
				{% if rows|length > 0 %}
					<div class="table-responsive">
						<table class="table table-bordered table-hover table-sm mb-0">
							<thead>
								<th></th>
								<th>Productos</th>
								<th>Total</th>
								<th>Fecha</th>
								<th></th>
							</thead>
							{% for row in rows %}
								{% set sell = row.sell %}
								<tr>
									<td style="width:60px;">
										<a href="{{ base_url }}/purchase/{{ sell.id }}" class="btn btn-xs btn-link" title="Ver Detalle"><i class="bi bi-eye"></i></a>
										<a href="report/ticket-re.php?id={{ sell.id }}" target="_blank" class="btn btn-xs btn-link" title="Imprimir Ticket"><i class="bi bi-receipt"></i></a>
									</td>
									<td>{{ row.count }}</td>
									<td><b>$ {{ row.total|number_format(2) }}</b></td>
									<td>{{ sell.created_at }}</td>
									<td style="width:30px;">
										<form action="{{ base_url }}/purchase/{{ sell.id }}/delete" method="POST" onsubmit="return confirm('¿Eliminar esta compra?');">
											{{ csrf_field() }}
											<button type="submit" class="btn btn-xs btn-danger"><i class="bi bi-trash"></i></button>
										</form>
									</td>
								</tr>
							{% endfor %}
						</table>
					</div>
				{% else %}
					<div class="jumbotron">
						<h2>No hay datos</h2>
						<p>No se ha realizado ninguna operacion.</p>
					</div>
				{% endif %}
			</div>
		</div>
	</div>
</div>
{% endblock %}
