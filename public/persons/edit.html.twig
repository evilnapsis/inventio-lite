{% extends "layouts/main.html.twig" %}
{% block title %}{{ edit_title }}{% endblock %}
{% block content %}
<div class="row">
  <div class="col-md-12">
  <h1>{{ edit_title }}</h1>
  <br>
<div class="card">
  <div class="card-header">
    {{ edit_header }}
  </div>
    <div class="card-body">

    <form class="form-horizontal" method="post" action="{{ base_url }}/{{ singular }}/{{ person.id }}/update" role="form">
      {{ csrf_field() }}

  <div class="form-group">
    <label class="col-lg-2 control-label">Nombre*</label>
    <div class="col-md-6">
      <input type="text" name="name" value="{{ person.name }}" class="form-control" placeholder="Nombre">
    </div>
  </div>
  <div class="form-group">
    <label class="col-lg-2 control-label">Apellido*</label>
    <div class="col-md-6">
      <input type="text" name="lastname" value="{{ person.lastname }}" required class="form-control" placeholder="Apellido">
    </div>
  </div>
  <div class="form-group">
    <label class="col-lg-2 control-label">Direccion*</label>
    <div class="col-md-6">
      <input type="text" name="address1" value="{{ person.address1 }}" class="form-control" required placeholder="Direccion">
    </div>
  </div>
  <div class="form-group">
    <label class="col-lg-2 control-label">Email*</label>
    <div class="col-md-6">
      <input type="text" name="email1" value="{{ person.email1 }}" class="form-control" placeholder="Email">
    </div>
  </div>

  <div class="form-group">
    <label class="col-lg-2 control-label">Telefono</label>
    <div class="col-md-6">
      <input type="text" name="phone1" value="{{ person.phone1 }}" class="form-control" placeholder="Telefono">
    </div>
  </div>

  <p class="alert alert-info">* Campos obligatorios</p>

  <div class="form-group">
    <div class="col-lg-offset-2 col-lg-10">
      <button type="submit" class="btn btn-primary">{{ edit_button }}</button>
    </div>
  </div>
</form>
    </div>
</div>

  </div>
</div>
{% endblock %}
